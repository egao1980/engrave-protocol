(in-package #:engrave-protocol/tests)

;;; layout.lisp: MAKE-LAYOUT and ENSURE-LAYOUT.

(deftest layout-defaults
  (let ((l (make-layout)))
    (ok (layout-p l))
    (ok (equal '(210 297) (layout-page-size l)) "A4")
    (ok (equal '(10 10 10 10) (layout-margins l)))
    (ok (eql 100 (layout-scale l)))
    (ok (eq :auto (layout-system-breaks l)))
    (ok (equalp l (make-layout)) "a value: EQUALP layouts")))

(deftest-parametrize layout-named-page-sizes
    ((name width height) :rows +page-sizes+)
  (ok (equal (list width height) (layout-page-size (make-layout :page-size name)))))

(deftest layout-given-values
  (let* ((size (list 2159/10 2794/10))
         (margins (list 1 2 3 4))
         (breaks (list "m-3" "m-1"))
         (l (make-layout :page-size size :margins margins :scale 40 :system-breaks breaks)))
    (ok (equal '(2159/10 2794/10) (layout-page-size l)))
    (ok (not (eq size (layout-page-size l))) "a fresh list")
    (ok (equal '(1 2 3 4) (layout-margins l)))
    (ok (not (eq margins (layout-margins l))) "a fresh list")
    (ok (eql 40 (layout-scale l)))
    (ok (equal '("m-3" "m-1") (layout-system-breaks l)) "the given order")
    (ok (not (eq breaks (layout-system-breaks l))) "a fresh list"))
  (ok (equal '(25/2 25/2 25/2 25/2) (layout-margins (make-layout :margins 25/2)))
      "one length for all four sides")
  (ok (equal '(0 0 0 0) (layout-margins (make-layout :margins 0))))
  (ok (equal '(100 200) (layout-page-size (make-layout :page-size '(100 200)))))
  (ok (eql 1 (layout-scale (make-layout :scale 1))))
  (ok (eql 1000 (layout-scale (make-layout :scale 1000))))
  (ok (null (layout-system-breaks (make-layout :system-breaks '())))
      "an empty list: no breaks besides the first measure")
  (ok (equal '(104 0 104 0) (layout-margins (make-layout :page-size :a5 :margins '(104 0 104 0))))
      "top + bottom just under the height"))

(defparameter +bad-layouts+
  '(((:page-size :a7) :page-size)
    ((:page-size "a4") :page-size)
    ((:page-size (210)) :page-size)
    ((:page-size (210 297 1)) :page-size)
    ((:page-size (210 0)) :page-size)
    ((:page-size (-210 297)) :page-size)
    ((:page-size (210.0 297)) :page-size)
    ((:page-size (2101/100 297)) :page-size)
    ((:margins -1) :margins)
    ((:margins 1.5) :margins)
    ((:margins 1/20) :margins)
    ((:margins (1 2 3)) :margins)
    ((:margins (1 2 3 -4)) :margins)
    ((:margins 105) :margins)
    ((:page-size :a5 :margins (105 0 105 0)) :margins)
    ((:page-size (100 200) :margins (0 60 0 40)) :margins)
    ((:scale 0) :scale)
    ((:scale 1001) :scale)
    ((:scale 50.0) :scale)
    ((:scale 1/2) :scale)
    ((:scale nil) :scale)
    ((:system-breaks "m-1") :system-breaks)
    ((:system-breaks :none) :system-breaks)
    ((:system-breaks ("m-1" "m-1")) :system-breaks)
    ((:system-breaks ("1bad")) :system-breaks)
    ((:system-breaks ("m 1")) :system-breaks)
    ((:system-breaks (:m-1)) :system-breaks)
    ((:page-size :bad :margins -1 :scale 0) :page-size)
    ((:margins -1 :scale 0) :margins)
    ((:scale 0 :system-breaks "x") :scale))
  "(make-layout arguments, the OPTION of the INVALID-RENDER-OPTION). The last
three rows check the order of the checks.")

(deftest-parametrize layout-refuses
    ((args option) :rows +bad-layouts+)
  (let ((c (signalled (lambda () (apply #'make-layout args)))))
    (ok (typep c 'invalid-render-option) (format nil "~S" args))
    (ok (and (typep c 'invalid-render-option)
             (eq option (invalid-render-option-option c)))
        (format nil "~S → ~S" args option))
    (ok (and (typep c 'invalid-render-option)
             (equal (getf args option) (invalid-render-option-value c)))
        "VALUE is the argument as given")))

(deftest ensure-layout-designators
  (ok (equalp (make-layout) (ensure-layout nil)))
  (let ((l (make-layout :scale 50)))
    (ok (eq l (ensure-layout l)) "a layout is itself"))
  (ok (eql 50 (layout-scale (ensure-layout '(:scale 50)))))
  (ok (equal '(148 210) (layout-page-size (ensure-layout '(:page-size :a5 :margins 0)))))
  (let ((c (signalled (lambda () (ensure-layout '(:scale 0))))))
    (ok (and (typep c 'invalid-render-option) (eq :scale (invalid-render-option-option c)))
        "a plist is checked by MAKE-LAYOUT")))

(deftest-parametrize ensure-layout-refuses
    ((designator) :rows '((42) ("a4") ((:scale)) ((:scale 50 :margins)) ((:foo 1)) ((:scale 50 :view :choral)) (#(1 2))))
  (let ((c (signalled (lambda () (ensure-layout designator)))))
    (ok (typep c 'invalid-render-option) (format nil "~S" designator))
    (ok (and (typep c 'invalid-render-option)
             (eq :layout (invalid-render-option-option c))
             (equalp designator (invalid-render-option-value c))))))
