(in-package #:engrave-protocol/tests)

;;; engine.lisp and render.lisp: engines, ENSURE-ENGINE, RENDER-SVG's steps.

(deftest engine-defaults
  (ok (equal "null" (engine-name (make-null-engine))))
  (ok (equal "plain-engine" (engine-name (make-instance 'plain-engine))))
  (ok (eq t (engine-available-p (make-instance 'plain-engine))))
  (ok (engine-available-p (make-null-engine)))
  (ok (null (null-engine-unsupported (make-null-engine))))
  (ok (equal '(sp:lyric) (null-engine-unsupported (make-null-engine :unsupported '(sp:lyric)))))
  (ok (typep (signalled (lambda () (make-null-engine :unsupported 'sp:lyric))) 'type-error)))

(deftest ensure-engine-cases
  (let ((e (make-null-engine)))
    (ok (eq e (ensure-engine e)))
    (let ((*engrave-engine* e))
      (ok (eq e (ensure-engine nil)) "NIL stands for *ENGRAVE-ENGINE*"))
    (let ((*engrave-engine* nil))
      (let ((c (signalled (lambda () (ensure-engine nil)))))
        (ok (typep c 'engine-unavailable))
        (ok (and (typep c 'engine-unavailable) (null (engrave-error-engine c))))
        (ok (and (typep c 'engine-unavailable) (stringp (engine-unavailable-reason c))))))
    (let* ((offline (make-instance 'offline-engine))
           (c (signalled (lambda () (ensure-engine offline)))))
      (ok (typep c 'engine-unavailable))
      (ok (and (typep c 'engine-unavailable) (eq offline (engrave-error-engine c))))
      (let ((*engrave-engine* offline))
        (ok (typep (signalled (lambda () (ensure-engine nil))) 'engine-unavailable)
            "an unavailable default engine")))
    (ok (typep (signalled (lambda () (ensure-engine 42))) 'type-error))
    (ok (typep (signalled (lambda () (ensure-engine :verovio))) 'type-error))
    ;; USE-VALUE: its value goes through ENSURE-ENGINE again.
    (let* ((*engrave-engine* nil)
           (seen 0)
           (restarts '())
           (result (handler-bind ((engine-unavailable
                                    (lambda (c)
                                      (incf seen)
                                      (push (mapcar #'restart-name (compute-restarts c)) restarts)
                                      (use-value (if (= seen 1) (make-instance 'offline-engine) e) c))))
                     (ensure-engine nil))))
      (ok (eq e result))
      (ok (= 2 seen) "an unavailable replacement signals again")
      (ok (every (lambda (names) (member 'use-value names)) restarts)))))

;;; RENDER-SVG: engine resolution (step 1).

(deftest render-svg-engine-resolution
  (let ((s (fixture-score "sc0-satb"))
        (expected (encode-pages (render (fixture-score "sc0-satb")))))
    (let ((*engrave-engine* nil))
      (let ((c (signalled (lambda () (render-svg nil s)))))
        (ok (typep c 'engine-unavailable) "no engine bound")))
    (let ((*engrave-engine* (make-null-engine)))
      (ok (equal expected (encode-pages (render-svg nil s))) "*ENGRAVE-ENGINE*"))
    (let* ((*engrave-engine* nil)
           (pages (handler-bind ((engine-unavailable
                                   (lambda (c) (use-value (make-null-engine) c))))
                    (render-svg nil s))))
      (ok (equal expected (encode-pages pages)) "USE-VALUE with no engine bound"))
    (let* ((offline (make-instance 'offline-engine))
           (c (signalled (lambda () (render-svg offline s)))))
      (ok (typep c 'engine-unavailable))
      (ok (and (typep c 'engine-unavailable) (eq offline (engrave-error-engine c)))))
    (let* ((recording (make-instance 'recording-engine))
           (pages (handler-bind ((engine-unavailable
                                   (lambda (c) (use-value recording c))))
                    (render-svg (make-instance 'offline-engine) s :layout '(:scale 50) :page 1))))
      (ok (equal (encode-pages (render s :layout '(:scale 50) :page 1)) (encode-pages pages))
          "the replacement renders with the same arguments")
      (ok (= 1 (length (recording-engine-calls recording))) "the replacement's own methods run")
      (ok (eql 50 (layout-scale (second (first (recording-engine-calls recording)))))))))

;;; RENDER-SVG: what the engine is given (steps 2 to 7).

(deftest render-svg-engine-arguments
  (let* ((s (fixture-score "sc1-open-score"))
         (e (make-instance 'recording-engine)))
    (render-svg e s)
    (destructuring-bind (view layout page) (first (recording-engine-calls e))
      (ok (eq s view) ":choral: the score itself")
      (ok (equalp (make-layout) layout) "NIL layout: the default LAYOUT")
      (ok (null page)))
    (render-svg e s :view :condensed :layout (make-layout :page-size :a5) :page 1)
    (destructuring-bind (view layout page) (second (recording-engine-calls e))
      (ok (equal (element-ids (engrave-view s :view :condensed)) (element-ids view))
          ":condensed: ENGRAVE-VIEW's score")
      (ok (equal '(148 210) (layout-page-size layout)))
      (ok (eql 1 page) "PAGE is passed on"))
    (let ((parts (part-ids s)))
      (render-svg e s :parts (list (third parts)) :layout '(:system-breaks ("m-2")))
      (destructuring-bind (view layout page) (third (recording-engine-calls e))
        (declare (ignore page))
        (ok (equal (list (third parts)) (part-ids view)) ":parts")
        (ok (equal '("m-2") (layout-system-breaks layout)) "a plist layout")))))

(deftest render-svg-refuses
  (let ((s (fixture-score "sc0-satb"))
        (e (make-null-engine)))
    (ok (typep (signalled (lambda () (render-svg e 42))) 'type-error) "SCORE")
    (ok (typep (signalled (lambda () (render-svg e "<score/>"))) 'type-error))
    (flet ((option-of (thunk)
             (let ((c (signalled thunk)))
               (and (typep c 'invalid-render-option) (invalid-render-option-option c)))))
      (ok (eq :layout (option-of (lambda () (render-svg e s :layout 42)))))
      (ok (eq :scale (option-of (lambda () (render-svg e s :layout '(:scale 0))))))
      (ok (eq :view (option-of (lambda () (render-svg e s :view :piano)))))
      (ok (eq :parts (option-of (lambda () (render-svg e s :parts '("nope"))))))
      (ok (eq :system-breaks (option-of (lambda () (render-svg e s :layout '(:system-breaks ("e-9"))))))
          "an event id is not a measure")
      (ok (eq :system-breaks (option-of (lambda () (render-svg e s :layout '(:system-breaks ("m-1" "m-99")))))))
      (dolist (page '(0 -1 "1" 1.0 :first))
        (ok (eq :page (option-of (lambda () (render-svg e s :page page)))) (format nil "page ~S" page)))
      (ok (eq :page (option-of (lambda () (render-svg e s :page 2)))) "past the last page")
      (ok (eq :layout (option-of (lambda () (render-svg e s :layout 42 :view :piano))))
          "the layout before the view")
      (ok (eq :view (option-of (lambda () (render-svg e s :view :piano :page 0))))
          "the view before the page"))
    (let ((c (signalled (lambda () (render-svg e s :page 9)))))
      (ok (and (typep c 'invalid-render-option) (eql 9 (invalid-render-option-value c))))
      (ok (and (typep c 'invalid-render-option) (eq e (engrave-error-engine c)))))
    (let ((c (signalled (lambda () (render-svg e s :layout '(:system-breaks ("e-9")))))))
      (ok (and (typep c 'invalid-render-option)
               (equal '("e-9") (invalid-render-option-value c))
               (eq e (engrave-error-engine c)))))
    (let ((recording (make-instance 'recording-engine)))
      (signalled (lambda () (render-svg recording s :page 0)))
      (ok (null (recording-engine-calls recording)) "a bad page is refused before rendering"))))

;;; RENDER-SVG: the result (steps 8 and 9).

(deftest render-svg-one-page
  (let ((s (long-score 40)))
    (multiple-value-bind (pages map) (render s :layout '(:scale 400))
      (ok (= 10 (length pages)))
      (multiple-value-bind (one one-map) (render s :layout '(:scale 400) :page 2)
        (ok (= 1 (length one)))
        (ok (eql 2 (svg-page-number (first one))))
        (ok (equal (encode-page (second pages)) (encode-page (first one))) "the same page")
        (ok (equal (svg-page-systems (second pages)) (svg-page-systems (first one))))
        (ok (maps-equal-p map one-map) "the id map of the whole rendering")))))

(deftest render-svg-source-ids
  (let ((s (fixture-score "sc1-open-score")))
    (multiple-value-bind (pages map) (render s :view :condensed)
      (multiple-value-bind (v view-map) (engrave-view s :view :condensed)
        (let ((source (loop for e in (sp:score-elements v)
                            for (src found) = (multiple-value-list (lookup view-map (sp:element-id e)))
                            when found collect src)))
          (ok (equal (sort (copy-list source) #'string<) (map-keys map))
              "keys: the view's elements that come from the score"))
        (let ((new-part (first (part-ids v))))
          (ok (null (nth-value 1 (lookup map new-part))) "the view's own part is dropped")
          (ok (groups-with-id pages new-part) "though it is drawn"))))))

(deftest render-svg-engine-errors-pass-through
  (let* ((s (fixture-score "sc0-satb"))
         (c (signalled (lambda () (render-svg (make-null-engine :unsupported '(sp:breath-mark)) s)))))
    (ok (typep c 'unsupported-notation))
    (ok (and (typep c 'unsupported-notation) (equal "br-n" (unsupported-notation-element-id c))))))
